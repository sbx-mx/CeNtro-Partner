{
  "name": "centro-partner",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "tsc -b --pretty false",
    "audit:data": "python scripts/validate_workbook.py \"public/data/Base_CeNtro Partner.xlsx\" --output public/data/workbook-audit.json",
    "audit:dependencies": "npm audit --omit=dev --audit-level=critical",
    "test:python": "python -m unittest discover -s tests -v",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.4.1",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "lucide-react": "0.468.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vite-plugin-pwa": "1.0.0"
  }
}
